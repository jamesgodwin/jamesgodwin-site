---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCaseStudy from '../../components/site/ProjectCaseStudy.astro';
import metadata from '../../siteMetadata';
const project={name:'Osteopathy practice',context:'Client system',web:true,logo:'/portfolio/osteopathy-mark.svg',title:'From appointments to client invoices.',summary:'The client had built an appointment system but was struggling to get it over the line. I helped connect the booking workflow with invoices carrying medical-aid references, ready to email to clients after their appointments.',role:'Workflow design · Web development · Appointment management · Invoicing',status:'Client system · Illustrated with fictional information',hero:'/portfolio/osteopathy-workflow.svg',heroAlt:'Fictional illustration of a completed osteopathy appointment leading to an invoice with example medical-aid references and an email to the client',heroCaption:'An illustrated workflow with fictional client details and reference placeholders. Not the client’s interface.',sections:[
{label:'The starting point',title:'The appointment was only part of the job.',paragraphs:['The client had created a system to book appointments for his clients. He also needed a way to handle the administration after a visit, and was struggling to get the whole workflow working.','Once an appointment was completed, he wanted to create an invoice with the relevant medical-aid references and email it to the client.']},
{label:'Getting it over the line',title:'Connect the booking with what happens next.',paragraphs:['My work focused on connecting the appointment, the invoice details and the email to the client.','The useful outcome was a joined-up workflow for the practice, carrying the work through beyond the calendar entry.']},
{label:'The invoice',title:'Give the client the details they need.',paragraphs:['Medical-aid references were part of the invoicing requirement. The invoice needed to carry those details alongside the appointment information before being emailed to the client.','The illustration shows where that information fits in the workflow. Its reference labels are fictional placeholders, not real membership numbers or billing codes.']},
{label:'Showing the work',title:'A clear story without exposing client records.',paragraphs:['Appointment and billing screens contain private client information. This case study uses an illustration to explain the workflow without showing those records.','The example follows a fictional appointment through to an invoice and email, keeping the emphasis on the connection between the steps.']}
]};
const pageMetadata={...metadata.defaultMetadata,title:'Osteopathy practice | James Godwin',description:project.summary,url:metadata.siteUrl+'/work/osteopathy-practice'};
---
<SiteLayout metadata={pageMetadata} current="work"><ProjectCaseStudy project={project}/></SiteLayout>
