---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCaseStudy from '../../components/site/ProjectCaseStudy.astro';
import metadata from '../../siteMetadata';
const project={phone:true,name:'GratefulFor',logo:'/gratefulfor-icon.webp',title:'A little room for gratitude.',summary:'A shared garden of anonymous gratitude. Plant a moment of thanks, or pause with someone else’s. A personal project about giving back, noticing the good and making appreciation part of an ordinary day.',role:'Product design · Web development · Mobile experience',website:'https://gratefulfor.com/',hero:'/portfolio/gratefulfor-reading.webp',heroAlt:'GratefulFor on iPhone showing a Bird Of Paradise and a shared gratitude',heroCaption:'A plant gives each shared moment of thanks a place in the garden.',sections:[
{label:'The starting point',title:'Something I wanted to give back.',paragraphs:['I’ve had the GratefulFor domain for many years. I’ve always wanted to use it to give something back to the community. Gratitude is something I believe in. There is so much we can give thanks for, even in an ordinary day.','The experience is as much about witnessing gratitude as sharing it. Reading what someone else appreciates can remind you of something in your own life, or encourage you to begin your own practice.']},
{label:'A change in direction',title:'From a world map to planting a gratitude.',paragraphs:['The first idea was a map that came alive as people posted around the world. It worked on desktop, but I struggled to make the design work well on a phone.','That became the reason to rethink the experience. Instead of trying to fit the map into a smaller screen, I moved towards planting a gratitude and designed around mobile first. One plant and one moment of thanks give the experience a quieter focus.']},
{label:'The experience',title:'Choose a plant. Share a moment of thanks.',paragraphs:['Choose your country and a plant, write what you’re grateful for, and plant it in the shared garden. The words are anonymous; the focus stays on the gratitude.','The botanical imagery gives a small act of appreciation something tangible. You can pause with a gratitude, move to the next one, or add your own.'],image:'/portfolio/gratefulfor-planting.webp',alt:'GratefulFor planting screen with plant choices, country selection and a gratitude field',width:1170,height:2532,caption:'The planting screen brings the choice of plant and the words of thanks into one flow.'},
{label:'The design intention',title:'Make space for appreciation.',paragraphs:['I wanted the experience to feel welcoming and unhurried. The plants, warm colours and space around the words make room to notice something worth giving thanks for.','The shift away from the map was a practical design decision. Getting the mobile experience right mattered more than keeping the first concept. The project continues to grow around that principle.']}
]};
const pageMetadata={...metadata.defaultMetadata,title:'GratefulFor | James Godwin',description:project.summary,url:metadata.siteUrl+'/work/gratefulfor'};
---
<SiteLayout metadata={pageMetadata} current="work"><ProjectCaseStudy project={project}/></SiteLayout>
