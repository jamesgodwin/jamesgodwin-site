---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCaseStudy from '../../components/site/ProjectCaseStudy.astro';
import metadata from '../../siteMetadata';
const project={name:'Taoist Breath',phone:true,logo:'/taoistbreath-logo.svg',title:'Practice between classes.',summary:'A focused breathing companion I built for my Taoist students. Choose a practice, set aside a little time and follow a simple visual rhythm.',role:'Product design · Web development · Guided practice',website:'https://taoistbreath.com',heroScreens:[{src:'/portfolio/taoist-breath-4001.webp',alt:'Taoist Breath session start and duration'},{src:'/portfolio/taoist-breath-4002.webp',alt:'Taoist Breath visual circle with the Inhale prompt'},{src:'/portfolio/taoist-breath-4003.webp',alt:'Taoist Breath list of available practices'}],heroCaption:'Choose a practice, start a session and follow the breathing rhythm.',sections:[
{label:'The starting point',title:'Something to return to after class.',paragraphs:['I built Taoist Breath for my Taoist students, to support their breath work between classes. I wanted a focused tool that could sit alongside what we practise together.','The design keeps the journey short. Choose the practice, set a duration and begin.'],links:[{href:'/dantian',label:'The teaching behind Taoist Breath'},{href:'/return-to-stillness',label:'Explore a one to one session'}]},
{label:'The session',title:'One clear rhythm to follow.',paragraphs:['The breathing screen gives the current phase its own space. A simple circle and a short prompt keep attention on the practice.','The start screen keeps the selected rhythm and session duration visible before you begin.'],image:'/portfolio/taoist-breath-4002.webp',alt:'Taoist Breath Inhale screen in a phone frame',width:1170,height:2532,caption:'A clear visual cue for the current phase of the practice.'},
{label:'Choosing a practice',title:'Make the rhythm visible before starting.',paragraphs:['The practice selector brings the name, timing and short explanation together. You can see the shape of a session before choosing it.','The interface stays quiet and consistent across the selector, start screen and active session.'],image:'/portfolio/taoist-breath-4003.webp',alt:'Taoist Breath practice selector in a phone frame',width:1170,height:2532,caption:'Practice names and timings presented together.'}
]};
const pageMetadata={...metadata.defaultMetadata,title:'Taoist Breath | James Godwin',description:project.summary,url:metadata.siteUrl+'/work/taoist-breath'};
---
<SiteLayout metadata={pageMetadata} current="work"><ProjectCaseStudy project={project}/></SiteLayout>
