---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCaseStudy from '../../components/site/ProjectCaseStudy.astro';
import metadata from '../../siteMetadata';
const project={name:'Cape Vision',context:'Client system',web:true,logo:'/portfolio/cape-vision-mark.svg',title:'Patient records, connected to WhatsApp.',summary:'The client had built a reminder tool with AI and needed help getting it working. I connected WhatsApp messaging with their patient-management workflow, helping turn the prototype into a practical tool for the practice.',role:'Workflow design · Web development · WhatsApp integration · Patient CRM',status:'Client system · Illustrated with fictional information',hero:'/portfolio/cape-vision-workflow.svg',heroAlt:'Fictional illustration connecting a patient record to a WhatsApp appointment reminder and follow-up',heroCaption:'An illustration of the workflow using fictional information. This is not the client’s interface.',sections:[
{label:'The starting point',title:'A useful prototype that needed connecting.',paragraphs:['The client had used AI to build a tool for sending reminders to patients. The idea was clear, but they needed help getting the tool working and integrating it with WhatsApp.','My role was to help get that build over the line, connecting the messaging requirement with the practical work of managing patients.']},
{label:'The integration',title:'Bring messaging into the working system.',paragraphs:['WhatsApp was part of how the practice wanted to communicate with patients. I implemented the integration so messaging could become part of the tool’s workflow.','The work grew to include a patient CRM tied into that messaging system, bringing patient management and communication together.']},
{label:'The design problem',title:'Think beyond the reminder itself.',paragraphs:['A reminder is one part of a broader workflow. Staff also need a way to manage patient records and the communication around appointments.','The project connected those needs around the client’s existing idea, extending the prototype into a tool that could support more of the practice’s working day.']},
{label:'Showing the work',title:'Explain the workflow while respecting patient privacy.',paragraphs:['Patient information belongs within the practice. This case study uses a fictional record and message to illustrate the connection between patient management and WhatsApp communication.','The illustration explains the work without reproducing the client’s screens or any patient data.']}
]};
const pageMetadata={...metadata.defaultMetadata,title:'Cape Vision | James Godwin',description:project.summary,url:metadata.siteUrl+'/work/capevision'};
---
<SiteLayout metadata={pageMetadata} current="work"><ProjectCaseStudy project={project}/></SiteLayout>
