---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCaseStudy from '../../components/site/ProjectCaseStudy.astro';
import metadata from '../../siteMetadata';
const project={name:'Between Breaths',phone:true,logo:'/pause-icon.webp',title:'A small pause. A shared moment.',summary:'Set a reminder to stop, look up and breathe. When other people are practising at the same time, Between Breaths shows how many are in stillness with you, connecting a personal pause with people elsewhere in the world.',role:'Product design · Mobile development · Reminders · Shared presence',website:'https://apps.apple.com/us/app/between-breaths/id6753753806',heroScreens:[{src:'/portfolio/between-breaths-begin.webp',alt:'Between Breaths Begin screen'},{src:'/portfolio/between-breaths-session.webp',alt:'Between Breaths active timed session'}],heroCaption:'A simple invitation to begin, followed by a quiet timed practice.',sections:[
{label:'The starting point',title:'Make room for a pause in the day.',paragraphs:['I wanted a gentle reminder to stop, look up and breathe. Between Breaths gives that moment a simple place in an ordinary working day.','The screen invites you to begin, settle into the session and give yourself a little space.']},
{label:'Shared presence',title:'In stillness with you.',paragraphs:['Imagine setting a reminder for 9 a.m. When you begin your pause, someone elsewhere in the world may be taking the same moment for themselves. The app can show how many people are practising at that time, with the words “in stillness with you”.','Reminders follow your local time. The connection is through overlapping sessions around the world, offering a shared moment of attention without needing to arrange a call or conversation.','The shared-presence count appears when more than one person is active. A small sign of company keeps that connection visible while leaving the practice itself quiet.']},
{label:'The interaction',title:'Leave space around the practice.',paragraphs:['A small visual rhythm and a timer give the session its structure. The dark screen and sparse controls keep attention on the pause.','The design is deliberately simple, with a clear beginning and room to return to the day afterwards.'],image:'/portfolio/between-breaths-session.webp',alt:'Between Breaths phone screen showing its session circle and remaining time',width:1170,height:2532,caption:'A quiet session with a visual cue and remaining time.'}
]};
const pageMetadata={...metadata.defaultMetadata,title:'Between Breaths | James Godwin',description:project.summary,url:metadata.siteUrl+'/work/between-breaths'};
---
<SiteLayout metadata={pageMetadata} current="work"><ProjectCaseStudy project={project}/></SiteLayout>
