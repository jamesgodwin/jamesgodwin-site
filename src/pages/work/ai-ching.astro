---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCaseStudy from '../../components/site/ProjectCaseStudy.astro';
import metadata from '../../siteMetadata';
const project={downloads:[{label:'Download for iPhone ↗',url:'https://apps.apple.com/app/id6446175523'},{label:'Get it for Android ↗',url:'https://play.google.com/store/apps/details?id=app.aiching2.aiching'}],phone:true,name:'AI Ching app',logo:'/ai-ching-logo.webp',title:'Years of reading, close at hand.',summary:'A mobile companion to the I Ching, shaped by years of collecting and comparing translations. Explore the 64 hexagrams and their interpretations in a reading experience designed to travel with you.',role:'Product design · Mobile development · Content and reading experience',website:'https://aiching.app/download-aiching-app',hero:'/portfolio/aiching-library.webp',heroAlt:'AI Ching app showing its library of 64 hexagrams',heroCaption:'The hexagram library, with symbols, names and a direct path into each interpretation.',sections:[
{label:'The starting point',title:'I can’t resist a secondhand bookshop.',paragraphs:['I’ve collected I Ching translations for years. Whenever I find myself in a secondhand bookshop, I look for another one. Different translations have spoken to me at different points in my life.','I wanted to bring together what I’d learned from that collection. AI helped me work through the material and develop my interpretation, but I built the app because I wanted to carry this reading practice with me instead of needing all my books nearby.']},
{label:'The mobile experience',title:'A complete library in your pocket.',paragraphs:['The library presents each of the 64 hexagrams with its number, symbol and name. From there, the reader can open the interpretation and spend time with it.','The app brings the library, casting and journal into the same mobile experience. The companion website offers the core reading experience in a browser, while the app keeps a personal journal alongside the readings.']},
{label:'Reading and perspective',title:'Give the words room.',paragraphs:['The interpretation screen combines the hexagram, its trigrams and the reading itself. Main, Love, Career and Business are visible entry points for exploring different contexts.','The design uses restrained colour, clear symbols and generous typography to make a substantial body of reading approachable on a phone. The screenshots here show the dark appearance, with gold accents and warm text.'],image:'/portfolio/aiching-interpretation.webp',alt:'The Creative hexagram interpretation in the AI Ching mobile app',width:1170,height:2532,caption:'The Creative, with its identity and interpretation in one reading flow.'},
{label:'My contribution',title:'From a personal collection to a working app.',paragraphs:['I brought together the product design, mobile development and reading content, carrying the idea from my own study into a working mobile companion.','The aim is to keep the material close at hand when I want to consult it, explore a different perspective or return to a reading. The journal gives those readings a place to return to alongside my own notes.']}
]};
const pageMetadata={...metadata.defaultMetadata,title:'AI Ching app | James Godwin',description:project.summary,url:metadata.siteUrl+'/work/ai-ching'};
---
<SiteLayout metadata={pageMetadata} current="work"><ProjectCaseStudy project={project}/><p><a href="/work/ai-ching-website">Explore the AI Ching website story →</a></p></SiteLayout>
