---
import SiteLayout from '../layouts/SiteLayout.astro';
import PortfolioShowcase from '../components/site/PortfolioShowcase.astro';
import WritingList from '../components/site/WritingList.astro';
import { publishedEssays } from '../essays.js';
import metadata from '../siteMetadata';
const essays=await publishedEssays();
---
<SiteLayout metadata={metadata.defaultMetadata} current="work">
 <PortfolioShowcase />
 <section class="site-section" aria-labelledby="home-writing"><div class="site-section-heading"><h2 id="home-writing">Essays.</h2><nav class="writing-nav" aria-label="Browse writing"><a href="/essays">All essays →</a><a href="/notes">Short notes →</a></nav></div><WritingList essays={essays.slice(0,3)} /></section>
</SiteLayout>
