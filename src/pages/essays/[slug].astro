---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContentProse from '../../components/ui/ContentProse.astro';
import WritingSubscribe from '../../components/site/WritingSubscribe.astro';
import EssayCard from '../../components/site/EssayCard.astro';
import { publishedEssays, readingMinutes, displayDate, essayPath } from '../../essays.js';
import siteMetadata from '../../siteMetadata';
export async function getStaticPaths(){return (await publishedEssays()).map(essay=>({params:{slug:essay.id},props:{essay}}));}
const {essay}=Astro.props;
const {Content}=await render(essay);
const data=essay.data;
const image=await getImage({src:data.cover,width:1200,format:'webp',quality:data.coverQuality});
const url=siteMetadata.siteUrl+essayPath(essay);
const metadata={title:`${data.title} | James Godwin`,description:data.lead,url,path:essayPath(essay),image:siteMetadata.siteUrl+image.src,imageWidth:image.attributes.width,imageHeight:image.attributes.height,imageAlt:data.coverAlt};
const schema={'@context':'https://schema.org','@type':'Article',headline:data.title,description:data.lead,datePublished:data.date.toISOString(),image:[metadata.image],mainEntityOfPage:url,author:{'@type':'Person',name:'James Godwin',url:siteMetadata.siteUrl+'/about'},isBasedOn:data.sourceUrl};
const related=(await publishedEssays()).filter(item=>item.id!==essay.id).slice(0,2);
---
<SiteLayout metadata={metadata} current="writing" article>
 <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema).replace(/</g,'\u003c')} />
 <article class="essay">
  <a class="writing-read" href="/essays">← All essays</a>
  <header class="essay-header"><p class="eyebrow"><time datetime={data.date.toISOString()}>{displayDate(data.date)}</time> · {readingMinutes(essay)} min read</p><h1>{data.title}</h1><p>James Godwin</p><div class="essay-byline"><a href={data.sourceUrl} target="_blank" rel="noopener noreferrer">Originally published on LinkedIn ↗</a></div></header>
  <figure class="essay-cover"><Image src={data.cover} alt={data.coverAlt} widths={[600,1000,1280]} sizes="(max-width:768px) 100vw, 1120px" width={1280} format="webp" quality={data.coverQuality} /></figure>
  <div class="essay-body"><ContentProse reading><Content /></ContentProse><WritingSubscribe /><p><a class="writing-read" href="/contact">Get in touch →</a></p></div>
  <section class="essay-related"><h2>More essays</h2><div class="writing-grid writing-grid--two">{related.map(item=><EssayCard essay={item} />)}</div></section>
 </article>
</SiteLayout>
