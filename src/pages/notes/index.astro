---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WritingNav from '../../components/site/WritingNav.astro';
import NoteCard from '../../components/site/NoteCard.astro';
import { publishedNotes } from '../../notes.js';
import metadata from '../../siteMetadata';
const notes=await publishedNotes();
---
<SiteLayout metadata={metadata.sectionMetadata.notes} current="notes">
 <header class="review-intro"><h1>Notes.</h1><p class="concept-lead">Short pieces from work and practice.</p><WritingNav current="notes" /></header>
 <section class="site-section writing-index" aria-label="Notes"><div class="writing-grid">{notes.map(note=><NoteCard note={note} />)}</div></section>
</SiteLayout>
