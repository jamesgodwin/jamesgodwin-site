---
import NoteArchive from '../../../components/site/NoteArchive.astro';
import { publishedNotes } from '../../../notes.js';
import { noteArchivePages } from '../../../note-pagination.js';
export async function getStaticPaths(){
 return noteArchivePages(await publishedNotes()).slice(1).map(page=>({params:{page:String(page.number)},props:{page}}));
}
const {page}=Astro.props;
---
<NoteArchive page={page} />
