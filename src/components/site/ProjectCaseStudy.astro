---
import Action from '../ui/Action.astro';
import PhoneScreens from './PhoneScreens.astro';
const { project } = Astro.props;
---
<article data-project={project.slug} class:list={["project-case", {"project-case--phone": project.phone, "project-case--web": project.web}]} >
 <a href="/">← Back to the portfolio</a>
 <header class="project-case__header">
  <div class="project-case__identity"><img src={project.logo} alt="" width="72" height="72"/><p class="eyebrow">{project.name}{project.context && <> · {project.context}</>}</p></div>
  <h1>{project.title}</h1><p class="concept-lead">{project.summary}</p>
  <p class="project-case__role">{project.role}</p>
  <div class="project-case__action">{project.status ? <p class="project-case__role">{project.status}</p> : project.downloads ? project.downloads.map(download=><Action recipe="primary" href={download.url}>{download.label}</Action>) : <Action recipe="primary" href={project.website}>Visit {project.name} ↗</Action>}</div>
 </header>
 {project.heroShortcut && <p class="project-case__shortcut" aria-label={project.heroShortcut.join(" ")}>{project.heroShortcut.map(key=><kbd>{key}</kbd>)}</p>}
 <figure class="project-case__hero">{project.heroScreens ? <PhoneScreens screens={project.heroScreens}/> : project.phone ? <div class="project-case__phone"><img src={project.hero} alt={project.heroAlt} width="1170" height="2532"/></div> : <img src={project.hero} alt={project.heroAlt} width="820" height="619"/>}<figcaption>{project.heroCaption}</figcaption></figure>
 <div class="project-case__body">
 {project.sections.map(section=><section class="project-case__section"><p class="eyebrow">{section.label}</p><h2>{section.title}</h2>{section.metric && <div class="project-case__metric"><strong>{section.metric.value}</strong><p>{section.metric.label}</p><p class="project-case__metric-detail">{section.metric.detail}</p></div>}{section.shortcut && <p class="project-case__shortcut" aria-label={section.shortcut.join(" ")}>{section.shortcut.map(key=><kbd>{key}</kbd>)}</p>}{section.paragraphs.map(text=><p>{text}</p>)}{section.links && <ul class="project-case__links">{section.links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</ul>}{section.video && <figure class="project-case__demo"><video controls playsinline preload="none" poster={section.poster} aria-label={section.videoLabel}><source media="(max-width: 600px)" src={section.portraitVideo || section.video} type="video/mp4"/><source src={section.video} type="video/mp4"/>{section.captions && <track kind="captions" src={section.captions} srclang="en" label="English descriptions"/>}<a href={section.video}>Watch the demonstration</a></video><figcaption>{section.caption}</figcaption><p><a href={section.video}>Open the video ↗</a></p></figure>}{section.image&&<figure>{project.phone ? <div class="project-case__phone"><img src={section.image} alt={section.alt} width={section.width} height={section.height} loading="lazy"/></div> : <img src={section.image} alt={section.alt} width={section.width} height={section.height} loading="lazy"/>}<figcaption>{section.caption}</figcaption></figure>}</section>)}
 <section class="project-case__section"><h2>Have a build that needs to work better?</h2><p>I bring the same care to the products I help other people get over the line. I work to understand the real workflow, simplify the difficult steps and carry the design through implementation.</p><div class="project-case__action"><Action recipe="primary" href="/contact?about=product-clarity">Talk about your product →</Action></div></section>
 </div>
 <div class="concept-invitation"><a href="/">← Back to the showcase</a><a href="/apps">All apps and systems →</a></div>
</article>
