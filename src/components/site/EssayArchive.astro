---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WritingList from './WritingList.astro';
import Action from '../ui/Action.astro';
import siteMetadata from '../../siteMetadata';
const {page}=Astro.props;
const base=siteMetadata.sectionMetadata.essays;
const metadata={...base,path:page.path,url:siteMetadata.siteUrl+page.path,
 title:page.number===1?base.title:`Essays · Page ${page.number} | James Godwin`,
 description:page.number===1?base.description:`Page ${page.number} of James Godwin’s essays on software, AI, design and reflection.`};
---
<SiteLayout metadata={metadata} current="writing">
 <header class="review-intro"><h1>Essays.</h1><p class="concept-lead">On building software, working with AI, and the things I keep coming back to.</p></header>
 <section class="site-section writing-index" aria-label="Essays"><WritingList essays={page.essays} featured={page.number===1} /></section>
 {page.totalPages>1 && <nav class="essay-pagination" aria-label="Essay pages">
  {page.previous && <Action href={page.previous} rel="prev">← Previous</Action>}
  <p>Page {page.number} of {page.totalPages}<span>{page.start}–{page.end} of {page.totalEssays} essays</span></p>
  {page.next && <Action href={page.next} rel="next">Next →</Action>}
 </nav>}
</SiteLayout>
