---
import PhoneScreens from './PhoneScreens.astro';
import IIImpactArtwork from './IIImpactArtwork.astro';
import IMBArtwork from './IMBArtwork.astro';
import SwiftVeeArtwork from './SwiftVeeArtwork.astro';
import CompanyLogoArtwork from './CompanyLogoArtwork.astro';
const roofScreens=[{src:'/portfolio/roof-ops-worker.webp',alt:'Roof Ops mobile PWA worker and project selection'},{src:'/portfolio/roof-ops-scoring.webp',alt:'Roof Ops quality, productivity, compliance and teamwork scores'}];
const pauseScreens=[{src:'/portfolio/between-breaths-begin.webp',alt:'Between Breaths Begin screen'},{src:'/portfolio/between-breaths-session.webp',alt:'Between Breaths quiet timed session'}];
const breathScreens=[{src:'/portfolio/taoist-breath-4001.webp',alt:'Taoist Breath start screen and session duration'},{src:'/portfolio/taoist-breath-4002.webp',alt:'Taoist Breath breathing circle showing Inhale'},{src:'/portfolio/taoist-breath-4003.webp',alt:'Taoist Breath practice selection'}];
const {app}=Astro.props;
---
{app.slug === 'dantian' ? <IIImpactArtwork thumbnail src="/portfolio/dantian-teaching.webp" labelLead="Teaching" label="Tai Chi" alt="James Godwin teaching Tai Chi with students"/> : app.slug === 'star120' ? <CompanyLogoArtwork thumbnail src="/portfolio/star120-logo.webp" alt="Star120 debit-order system logo"/> : app.slug === 'from-digital' ? <IIImpactArtwork thumbnail src="/portfolio/algoworks-website.webp" label="FROM / Algoworks" alt="Algoworks green and black brand artwork"/> : app.name === 'PrivySeal' ? <IIImpactArtwork thumbnail src="/portfolio/privyseal-website.webp" label="PrivySeal" alt="Current PrivySeal website credential-verification artwork"/> : app.name === 'StraTech' ? <CompanyLogoArtwork thumbnail src="/portfolio/stratech-logo.svg" alt="StraTech Strategic Technologies logo"/> : app.name === 'SwiftVEE' ? <SwiftVeeArtwork thumbnail/> : app.name === 'JUMO' ? <IIImpactArtwork thumbnail src="/portfolio/jumo-website-art.webp" label="JUMO"/> : app.name === 'Lobster Ink' ? <IIImpactArtwork thumbnail src="/portfolio/lobster-ink.webp" label="Lobster Ink"/> : app.name === 'IMB' ? <IMBArtwork thumbnail/> : app.name === 'IIIMPACT' ? <IIImpactArtwork thumbnail/> : app.name === 'Roof Ops' ? <PhoneScreens screens={[roofScreens[1]]} thumbnail/> : app.name === 'Between Breaths' ? <PhoneScreens screens={[pauseScreens[0]]} thumbnail/> : app.name === 'Taoist Breath' ? <PhoneScreens screens={[breathScreens[1]]} thumbnail/> : app.name === 'True Essence' ? <span class="gratefulfor-thumbnail"><span class="portfolio-phone"><img src="/portfolio/true-essence-practice.webp" alt="" width="1170" height="2532"/></span><span class="portfolio-phone"><img src="/portfolio/true-essence-sage.webp" alt="" width="1170" height="2532"/></span></span> : app.name === 'AI Ching app' ? <span class="gratefulfor-thumbnail"><span class="portfolio-phone"><img src="/portfolio/aiching-library.webp" alt="" width="1170" height="2532"/></span><span class="portfolio-phone"><img src="/portfolio/aiching-interpretation.webp" alt="" width="1170" height="2532"/></span></span> : app.name === 'GratefulFor' ? <span class="gratefulfor-thumbnail"><span class="portfolio-phone"><img src="/portfolio/gratefulfor-reading.webp" alt="" width="1170" height="2532"/></span><span class="portfolio-phone"><img src="/portfolio/gratefulfor-planting.webp" alt="" width="1170" height="2532"/></span></span> : app.name === 'TapScribe' ? <span class="tapscribe-thumbnail"><img src="/portfolio/tap2.webp" alt="" width="820" height="619"/><img src="/portfolio/tap1.webp" alt="" width="347" height="339"/></span> : app.image ? <img class:list={{"harmonic-echo-thumbnail":app.slug === "harmonic-echo"}} src={app.image} alt="" width="240" height="160" loading="lazy"/> : <span class="portfolio-thumbnail-label">Client system</span>}
