---
import TextLink from './ui/TextLink.astro';
const { workshop = false } = Astro.props;
---
<div data-contact data-workshop={workshop}>
<p data-contact-intro>Email or WhatsApp me about your product, workflow or practice enquiry. A short description of where you need help is enough to start.</p>
<p><strong>Current enquiry:</strong> <span data-contact-label>General Enquiry</span></p>
<p class="app-item"><img width="16" height="16" src="/images/email.svg" alt="" class="app-icon" /><span><strong>Email</strong><br /><Fragment set:html={'<!--email_off-->'} /><TextLink href="mailto:james@jamesgodwin.me" data-contact-method="email">james@jamesgodwin.me</TextLink><Fragment set:html={'<!--/email_off-->'} /></span></p>
<p class="app-item"><img width="16" height="16" src="/images/phone.svg" alt="" class="app-icon" /><span><strong>WhatsApp</strong><br /><TextLink href="https://wa.me/27686038834" target="_blank" rel="noopener noreferrer" data-contact-method="whatsapp">WhatsApp James</TextLink></span></p>
<p><strong>Other ways to connect</strong></p>
<p class="app-item"><img width="16" height="16" src="/images/phone.svg" alt="" class="app-icon" /><span><strong>Telephone</strong><br /><TextLink href="tel:+27686038834" data-contact-method="telephone">+27 68 603 8834</TextLink></span></p>
<p class="app-item"><img width="16" height="16" src="/images/linkedin.svg" alt="" class="app-icon" /><span><strong>Professional profile</strong><br /><TextLink href="https://www.linkedin.com/in/jamiegodwin/" target="_blank" rel="noopener noreferrer" data-contact-method="linkedin">LinkedIn</TextLink></span></p>
<div data-workshop-note hidden><hr /><p><TextLink href="/contact">Enquire about something else →</TextLink></p></div>
</div>
